# systemd EnvironmentFile syntax; install root:root 0600. No "export".
# URL-encode reserved characters in the database password.
# sslmode=disable is for PostgreSQL on the same machine's loopback only.
GONET_DATABASE_URL="postgresql://gonet_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/gonet?sslmode=disable"
GONET_SNMP_COMMUNITY="REPLACE_WITH_READ_ONLY_COMMUNITY"
# Generate interactively: /opt/gonet/gonet auth hash-password
# No default account. Do not store the plaintext password here.
GONET_ADMIN_USERNAME="REPLACE_WITH_ADMIN_USERNAME"
GONET_ADMIN_PASSWORD_HASH="REPLACE_WITH_BCRYPT_HASH"
GONET_SESSION_TTL="8h"
# Browser -> HTTPS Nginx -> loopback HTTP: cookie MUST remain Secure.
GONET_COOKIE_SECURE="true"
# Required with the bundled Nginx example. Omit for direct loopback access.
GONET_TRUSTED_PROXY_CIDRS="127.0.0.1/32"

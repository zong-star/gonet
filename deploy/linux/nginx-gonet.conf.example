# Install under nginx's http context: /etc/nginx/conf.d/gonet.conf.
# Replace the hostname, client subnet and TLS files before enabling.
map_hash_bucket_size 64;
map $http_host $gonet_host_ok {
    default 0;
    "gonet.intranet.example:8443" 1;
}
# Check the original public Origin before translating it for the local app.
map $http_origin $gonet_origin_ok {
    default 0;
    "" 1;
    "https://gonet.intranet.example:8443" 1;
}
server {
    listen 8443 ssl;
    server_name gonet.intranet.example;
    ssl_certificate /etc/nginx/tls/gonet.crt;
    ssl_certificate_key /etc/nginx/tls/gonet.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($gonet_host_ok = 0) { return 444; }
    if ($gonet_origin_ok = 0) { return 403; }
    # Browser clients' admin subnet; documentation example MUST be replaced.
    allow 192.0.2.0/24;
    deny all;
    satisfy all;
    # Application Session login is the default. Keep TLS and source restrictions.
    # If explicitly retaining Basic Auth, document the two independent accounts.
    client_max_body_size 128k;
    # Exactly the four read-only query route shapes. Invalid IDs are validated
    # by Go; no auth/*, old API or arbitrary /api/v1/ prefix gains Bearer access.
    # Set GONET_TRUSTED_PROXY_CIDRS=127.0.0.1/32 in GoNet's environment
    # so the Key allowlist uses the single IP overwritten below.
    location ~ ^/api/v1/(topology(/summary)?|devices/[^/]+(/neighbors)?)$ {
        auth_basic off;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host "127.0.0.1:8787";
        proxy_set_header Origin "http://127.0.0.1:8787";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # GoNet currently checks these exact loopback headers.
        proxy_set_header Host "127.0.0.1:8787";
        proxy_set_header Origin "http://127.0.0.1:8787";
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
}

[Unit]
Description=GoNet periodic LLDP scan
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=gonet
Group=gonet
WorkingDirectory=/var/lib/gonet
EnvironmentFile=/etc/gonet/gonet.env
ExecStart=/opt/gonet/gonet scan --config /var/lib/gonet/config.yaml --output /var/lib/gonet/outputs/scan-summary.json --overwrite
SuccessExitStatus=3 5
TimeoutStartSec=20min
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gonet
